<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeANDIY Write MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build wordcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to FreeANDIY Write alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="FreeANDIY Write"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="729507BA-B8B0-4221-848D-DEE6536FFFAD"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FreeANDIY Write word processor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FreeANDIY Write is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="WordcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="WordcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://freeandiy.freeandy.agency/write" />
    <Property Id="ARPURLUPDATEINFO" Value="https://freeandiy.freeandy.agency/write" />
    <Property Id="ARPHELPLINK" Value="https://github.com/FreeAndy21/freeandiy-write/issues" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch FreeANDIY Write (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FreeANDIY Write" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WordcraftExe]" />
    <CustomAction Id="LaunchWordcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWordcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FreeANDIY Write" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FreeANDIY Write" Level="1">
      <ComponentGroupRef Id="WordcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="WordcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="WordcraftApp" Guid="D14B967F-B80C-4F1C-BD6D-AB086760EFFF">
        <File Id="WordcraftExe" Source="$(var.BinDir)\freeandiy-write.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FreeANDIY Write"
              Description="FreeANDIY Write word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="WordcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\freeandiy-write.exe" Value="[#WordcraftExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a FreeANDIY Write ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so FreeANDIY Write shows in
           Explorer's "Open with". The Word, RTF and ODT types are also FreeANDIY Write's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="WordcraftFileTypes" Guid="266B1CA4-A846-4441-9C8D-5026DF942868">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="FreeANDIY Write" Value="Software\FreeANDIY Write\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities" Name="ApplicationName" Value="FreeANDIY Write" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities" Name="ApplicationIcon" Value="&quot;[#WordcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe" Name="FriendlyAppName" Value="FreeANDIY Write" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="FreeANDIY Write.Document" Description="Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.Document\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="FreeANDIY Write.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".docx" Value="FreeANDIY Write.Document" Type="string" />

        <ProgId Id="FreeANDIY Write.DocumentMacroEnabled" Description="Word Macro-Enabled Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.DocumentMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="FreeANDIY Write.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".docm" Value="FreeANDIY Write.DocumentMacroEnabled" Type="string" />

        <ProgId Id="FreeANDIY Write.Template" Description="Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.Template\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="FreeANDIY Write.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".dotx" Value="FreeANDIY Write.Template" Type="string" />

        <ProgId Id="FreeANDIY Write.TemplateMacroEnabled" Description="Word Macro-Enabled Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.TemplateMacroEnabled\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="FreeANDIY Write.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".dotm" Value="FreeANDIY Write.TemplateMacroEnabled" Type="string" />

        <ProgId Id="FreeANDIY Write.LegacyDocument" Description="Legacy Word Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.LegacyDocument\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="FreeANDIY Write.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".doc" Value="FreeANDIY Write.LegacyDocument" Type="string" />

        <ProgId Id="FreeANDIY Write.LegacyTemplate" Description="Legacy Word Template" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.LegacyTemplate\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="FreeANDIY Write.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".dot" Value="FreeANDIY Write.LegacyTemplate" Type="string" />

        <ProgId Id="FreeANDIY Write.RichText" Description="Rich Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.RichText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="FreeANDIY Write.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".rtf" Value="FreeANDIY Write.RichText" Type="string" />

        <ProgId Id="FreeANDIY Write.OpenDocumentText" Description="OpenDocument Text" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.OpenDocumentText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="FreeANDIY Write.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\FreeANDIY Write\Capabilities\FileAssociations" Name=".odt" Value="FreeANDIY Write.OpenDocumentText" Type="string" />

        <ProgId Id="FreeANDIY Write.Markdown" Description="Markdown Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.Markdown\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="FreeANDIY Write.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="FreeANDIY Write.PlainText" Description="Text Document" Icon="WordcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Write.PlainText\shell\open\command" Value="&quot;[#WordcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="FreeANDIY Write.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-write.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="WordcraftCli">
        <File Id="WordcraftCliExe" Source="$(var.BinDir)\freeandiy-write-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
